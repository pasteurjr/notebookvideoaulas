# Copie este arquivo para ".env" e preencha com as SUAS chaves.
# As duas contas precisam ter crédito para o notebook funcionar.

# LLM (DeepSeek) - crie a chave em https://platform.deepseek.com/api_keys
DEEPSEEK_API_KEY=coloque_sua_chave_aqui
DEEPSEEK_BASE_URL=https://api.deepseek.com
MODELO_LLM=deepseek/deepseek-v4-flash

# Busca no Google (Serper) - crie a chave em https://serper.dev/api-key
SERPER_API_KEY=coloque_sua_chave_aqui
